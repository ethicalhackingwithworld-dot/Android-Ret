<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cloud Utility Sync"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="20dp"/>

    <TextView
        android:id="@+id/statusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Firebase Status: Unknown"
        android:textSize="16sp"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/deviceIdTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Device ID: Unknown"
        android:textSize="14sp"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/permissionsStatusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Permissions: 0/0 granted"
        android:textSize="14sp"
        android:paddingBottom="16dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/startServiceButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Service"
        android:enabled="false"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/stopServiceButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stop Service"
        android:enabled="false"
        android:layout_marginBottom="16dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/syncContactsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sync Contacts"
        android:enabled="false"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/syncCallLogsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sync Call Logs"
        android:enabled="false"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/syncLocationButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sync Location"
        android:enabled="false"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/fullSyncButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Full Sync"
        android:enabled="false"
        android:backgroundTint="@android:color/holo_blue_dark"/>

</LinearLayout>
